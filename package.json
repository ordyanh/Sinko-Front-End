{
  "name": "my-react-router-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:local": "node scripts/switch-backend.js local && react-router dev",
    "dev:remote": "node scripts/switch-backend.js remote && react-router dev",
    "use:local": "node scripts/switch-backend.js local",
    "use:remote": "node scripts/switch-backend.js remote",
    "backend:status": "node scripts/switch-backend.js status",
    "deploy": "sh deploy.sh",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.7.1",
    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "axios": "^1.19.0",
    "http-proxy-middleware": "^4.2.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.84.0",
    "react-router": "^8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
