# ============================================================
# DigitalOcean Deployment Configuration (.env.deploy)
# Copy this file to .env.deploy and fill in your values:
# ============================================================

# 1. DigitalOcean Personal Access Token
# Create one at: https://cloud.digitalocean.com/account/api/tokens
# (Needs 'read' and 'write' scopes)
DO_API_TOKEN=

# 2. DigitalOcean App Platform App ID (optional, auto-detected if empty)
# Found in the DO URL: https://cloud.digitalocean.com/apps/<DO_APP_ID>
DO_APP_ID=

# 3. Application name in DigitalOcean App Platform
APP_NAME=synco-frontend

# 4. Target Git Branch to deploy (default: current active branch)
GIT_BRANCH=connect-to-backend

# 5. Live Frontend URL (used for post-deployment health check)
# e.g., https://synco-frontend-xxxx.ondigitalocean.app
LIVE_URL=
