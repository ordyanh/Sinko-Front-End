}

/* Colored Accents Hover States (Promotions, Badges, Action Buttons) */
.dark .hover\:text-violet-950:hover,
[data-theme="dark"] .hover\:text-violet-950:hover,
.dark .hover\:text-violet-900:hover,
[data-theme="dark"] .hover\:text-violet-900:hover,
