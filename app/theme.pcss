/* Focus and Active States in Dark Mode */
.dark .focus\:bg-white:focus:not(input):not(textarea):not(select),
[data-theme="dark"] .focus\:bg-white:focus:not(input):not(textarea):not(select),
.dark .focus-within\:bg-white:focus-within:not(.synko-search-filter-bar):not(.synko-map-search-bar),
[data-theme="dark"] .focus-within\:bg-white:focus-within:not(.synko-search-filter-bar):not(.synko-map-search-bar) {
  background-color: #1e293b !important;
}

.dark .focus\:bg-slate-50:focus:not(input):not(textarea):not(select),
[data-theme="dark"] .focus\:bg-slate-50:focus:not(input):not(textarea):not(select),
.dark .focus-within\:bg-slate-50:focus-within:not(.synko-search-filter-bar):not(.synko-map-search-bar),
[data-theme="dark"] .focus-within\:bg-slate-50:focus-within:not(.synko-search-filter-bar):not(.synko-map-search-bar) {
  background-color: #1e293b !important;
}

.dark .active\:bg-slate-100:active,
[data-theme="dark"] .active\:bg-slate-100:active {
  background-color: #243248 !important;
}

/* Dark Mode Text Hover States (Ensures White/Light Text Stays Clearly Visible) */
.dark .hover\:text-slate-950:hover,
