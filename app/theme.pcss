@custom-variant dark (&:where(.dark, .dark *, [data-theme="dark"], [data-theme="dark"] *));

@theme {
  --color-base-100: oklch(98% 0.02 240);
  --color-base-200: oklch(95% 0.03 240);
  --color-base-300: oklch(92% 0.04 240);
  --color-base-content: oklch(20% 0.05 240);

  --color-primary: oklch(55% 0.3 240);
  --color-primary-content: oklch(98% 0.01 240);
  --color-secondary: oklch(70% 0.25 200);
  --color-secondary-content: oklch(98% 0.01 200);
  --color-accent: oklch(65% 0.25 160);
  --color-accent-content: oklch(98% 0.01 160);
  --color-neutral: oklch(50% 0.05 240);
  --color-neutral-content: oklch(98% 0.01 240);
  --color-info: oklch(70% 0.2 220);
  --color-info-content: oklch(98% 0.01 220);
  --color-success: oklch(65% 0.25 140);
  --color-success-content: oklch(98% 0.01 140);
  --color-warning: oklch(80% 0.25 80);
  --color-warning-content: oklch(20% 0.05 80);
  --color-error: oklch(65% 0.3 30);
  --color-error-content: oklch(98% 0.01 30);

  --radius-selector: 1rem;
  --radius-field: 0.25rem;
  --radius-box: 0.5rem;
}

@utility btn-primary {
  background-color: var(--color-primary);
  color: var(--color-primary-content);

  &:hover {
    filter: brightness(0.95);
  }
}

@utility btn-secondary {
  background-color: transparent;
  border-width: 1px;
  border-style: solid;
  border-color: var(--color-base-300);
  color: var(--color-base-content);

  &:hover {
    background-color: var(--color-base-100);
  }
}

@utility btn-ghost {
  background-color: transparent;
  border-width: 1px;
  border-style: solid;
  border-color: var(--color-base-300);
  color: var(--color-base-content);

  &:hover {
    background-color: var(--color-base-100);
  }
}

:root {
  color-scheme: light;
  font-family: Manrope, ui-sans-serif, system-ui, sans-serif;
}

.dark, [data-theme="dark"] {
  color-scheme: dark;
  --color-base-100: oklch(22% 0.02 240);
  --color-base-200: oklch(17% 0.02 240);
  --color-base-300: oklch(28% 0.03 240);
  --color-base-content: oklch(96% 0.01 240);
}

[data-account-type="horeca"] {
  --color-primary: #ea580c;
  --color-primary-content: #ffffff;
}

[data-account-type="supplier"] {
  --color-primary: #0284c7;
  --color-primary-content: #ffffff;
}

.dark [data-account-type="horeca"],
[data-theme="dark"] [data-account-type="horeca"] {
  --color-primary: #f97316;
  --color-primary-content: #ffffff;
}

.dark [data-account-type="supplier"],
[data-theme="dark"] [data-account-type="supplier"] {
  --color-primary: #0ea5e9;
  --color-primary-content: #ffffff;
}

body {
  background-color: oklch(95% 0.03 240);
  color: oklch(20% 0.05 240);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.dark body,
[data-theme="dark"] body {
  background-color: #0b0f17;
  color: #f1f5f9;
}

/* ==========================================================================
   Dark Theme Surface & Text Palette (Curated & Harmonious)
   ========================================================================== */

.dark .bg-\[\#f3f6f4\],
[data-theme="dark"] .bg-\[\#f3f6f4\] {
  background-color: #0b0f17 !important;
}

.dark .bg-\[\#f3f6f4\]\/95,
[data-theme="dark"] .bg-\[\#f3f6f4\]\/95 {
  background-color: rgba(11, 15, 23, 0.95) !important;
}

.dark .bg-\[\#fffefa\],
[data-theme="dark"] .bg-\[\#fffefa\] {
  background-color: #131b2a !important;
}

.dark .bg-white,
[data-theme="dark"] .bg-white {
  background-color: #131b2a;
}

.dark .bg-white\/90,
[data-theme="dark"] .bg-white\/90 {
  background-color: rgba(19, 27, 42, 0.92);
}

.dark .bg-white\/80,
[data-theme="dark"] .bg-white\/80 {
  background-color: rgba(19, 27, 42, 0.82);
}

.dark .bg-slate-50,
[data-theme="dark"] .bg-slate-50 {
  background-color: #182234;
}

.dark .bg-slate-50\/80,
[data-theme="dark"] .bg-slate-50\/80 {
  background-color: rgba(24, 34, 52, 0.8);
}

.dark .bg-slate-100,
[data-theme="dark"] .bg-slate-100 {
  background-color: #1e293b;
}

.dark .bg-slate-100\/80,
[data-theme="dark"] .bg-slate-100\/80 {
  background-color: rgba(30, 41, 59, 0.8);
}

.dark .border-slate-200,
[data-theme="dark"] .border-slate-200 {
  border-color: #1e293b;
}

.dark .border-slate-200\/80,
[data-theme="dark"] .border-slate-200\/80 {
  border-color: rgba(30, 41, 59, 0.8);
}

.dark .border-slate-300,
[data-theme="dark"] .border-slate-300 {
  border-color: #334155;
}

.dark .divide-slate-100,
.dark .divide-slate-200,
[data-theme="dark"] .divide-slate-100,
[data-theme="dark"] .divide-slate-200 {
  border-color: #1e293b;
}

.dark .text-slate-900,
.dark .text-slate-950,
[data-theme="dark"] .text-slate-900,
[data-theme="dark"] .text-slate-950 {
  color: #f8fafc;
}

.dark .text-slate-800,
[data-theme="dark"] .text-slate-800 {
  color: #f1f5f9;
}

.dark .text-slate-700,
[data-theme="dark"] .text-slate-700 {
  color: #cbd5e1;
}

.dark .text-slate-600,
.dark .text-slate-500,
[data-theme="dark"] .text-slate-600,
[data-theme="dark"] .text-slate-500 {
  color: #94a3b8;
}

.dark .hover\:bg-slate-50:hover,
[data-theme="dark"] .hover\:bg-slate-50:hover {
  background-color: #1e293b;
}

.dark .hover\:bg-slate-100:hover,
[data-theme="dark"] .hover\:bg-slate-100:hover {
  background-color: #243248;
}

.dark .hover\:text-slate-900:hover,
[data-theme="dark"] .hover\:text-slate-900:hover {
  color: #f8fafc;
}

/* Status Badges in Dark Mode */
.dark .bg-amber-50,
[data-theme="dark"] .bg-amber-50 {
  background-color: rgba(245, 158, 11, 0.16);
  color: #fde68a;
  border-color: rgba(245, 158, 11, 0.3);
}

.dark .bg-rose-50,
[data-theme="dark"] .bg-rose-50 {
  background-color: rgba(244, 63, 94, 0.16);
  color: #fecdd3;
  border-color: rgba(244, 63, 94, 0.3);
}

.dark .bg-emerald-50,
[data-theme="dark"] .bg-emerald-50 {
  background-color: rgba(16, 185, 129, 0.16);
  color: #a7f3d0;
  border-color: rgba(16, 185, 129, 0.3);
}

.dark .bg-sky-50,
[data-theme="dark"] .bg-sky-50 {
  background-color: rgba(14, 165, 233, 0.16);
  color: #bae6fd;
  border-color: rgba(14, 165, 233, 0.3);
}

.dark .bg-violet-50,
[data-theme="dark"] .bg-violet-50 {
  background-color: rgba(139, 92, 246, 0.16);
  color: #ddd6fe;
  border-color: rgba(139, 92, 246, 0.3);
}

.dark .bg-indigo-50,
[data-theme="dark"] .bg-indigo-50 {
  background-color: rgba(99, 102, 241, 0.16);
  color: #c7d2fe;
  border-color: rgba(99, 102, 241, 0.3);
}

.dark .bg-cyan-50,
[data-theme="dark"] .bg-cyan-50 {
  background-color: rgba(6, 182, 212, 0.16);
  color: #a5f3fc;
  border-color: rgba(6, 182, 212, 0.3);
}

/* Form Controls in Dark Mode */
.dark input[type="text"],
.dark input[type="search"],
.dark input[type="password"],
.dark input[type="email"],
.dark input[type="number"],
.dark input[type="tel"],
.dark select,
.dark textarea,
[data-theme="dark"] input[type="text"],
[data-theme="dark"] input[type="search"],
[data-theme="dark"] input[type="password"],
[data-theme="dark"] input[type="email"],
[data-theme="dark"] input[type="number"],
[data-theme="dark"] input[type="tel"],
[data-theme="dark"] select,
[data-theme="dark"] textarea {
  color-scheme: dark;
}

/* Leaflet in Dark Mode */
.dark .leaflet-container,
[data-theme="dark"] .leaflet-container {
  background-color: #0b0f17;
}

.dark .leaflet-popup-content-wrapper,
.dark .leaflet-popup-tip,
[data-theme="dark"] .leaflet-popup-content-wrapper,
[data-theme="dark"] .leaflet-popup-tip {
  background: #131b2a;
  color: #f8fafc;
  border: 1px solid #1e293b;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
}

.dark .leaflet-bar a,
[data-theme="dark"] .leaflet-bar a {
  background-color: #131b2a;
  color: #f8fafc;
  border-bottom: 1px solid #1e293b;
}

.dark .leaflet-bar a:hover,
[data-theme="dark"] .leaflet-bar a:hover {
  background-color: #1e293b;
}
