  color: #a5f3fc;
  border-color: rgba(6, 182, 212, 0.3);
}

/* ==========================================================================
   Form Controls & Input Fields in Dark Mode
   In dark mode, all input fields, textareas, and selects (including inside
   modals/popups) use a light slightly-grayish white background (#f1f5f9)
   with dark text (#0f172a), as well as when selecting text with the mouse.
   ========================================================================== */
.dark input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="file"]):not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="image"]):not(.bg-transparent),
.dark textarea,
.dark select,
.dark .synko-select-trigger,
[data-theme="dark"] input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="file"]):not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="image"]):not(.bg-transparent),
[data-theme="dark"] textarea,
[data-theme="dark"] select,
[data-theme="dark"] .synko-select-trigger {
  background-color: #f1f5f9 !important;
  color: #0f172a !important;
  caret-color: #0f172a !important;
  border-color: #cbd5e1 !important;
  color-scheme: light !important;
  -webkit-text-fill-color: #0f172a !important;
}

.dark input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="file"]):not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="image"]):not(.bg-transparent):hover:not(:disabled),
.dark textarea:hover:not(:disabled),
.dark select:hover:not(:disabled),
.dark .synko-select-trigger:hover:not(:disabled),
[data-theme="dark"] input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="file"]):not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="image"]):not(.bg-transparent):hover:not(:disabled),
[data-theme="dark"] textarea:hover:not(:disabled),
[data-theme="dark"] select:hover:not(:disabled),
[data-theme="dark"] .synko-select-trigger:hover:not(:disabled) {
  background-color: #f1f5f9 !important;
  color: #0f172a !important;
  border-color: #94a3b8 !important;
  -webkit-text-fill-color: #0f172a !important;
}

.dark input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="file"]):not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="image"]):not(.bg-transparent):focus,
.dark textarea:focus,
.dark select:focus,
.dark .synko-select-trigger:focus,
.dark .synko-select-trigger[data-headlessui-state*="open"],
[data-theme="dark"] input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="file"]):not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="image"]):not(.bg-transparent):focus,
[data-theme="dark"] textarea:focus,
[data-theme="dark"] select:focus,
[data-theme="dark"] .synko-select-trigger:focus,
[data-theme="dark"] .synko-select-trigger[data-headlessui-state*="open"] {
  background-color: #f8fafc !important;
  color: #0f172a !important;
  border-color: var(--color-primary) !important;
  -webkit-text-fill-color: #0f172a !important;
}

.dark input[aria-invalid="true"]:not(.bg-transparent),
.dark textarea[aria-invalid="true"],
.dark select[aria-invalid="true"],
.dark .synko-select-trigger[aria-invalid="true"],
[data-theme="dark"] input[aria-invalid="true"]:not(.bg-transparent),
[data-theme="dark"] textarea[aria-invalid="true"],
[data-theme="dark"] select[aria-invalid="true"],
[data-theme="dark"] .synko-select-trigger[aria-invalid="true"] {
  border-color: #ef4444 !important;
}

.dark input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="file"]):not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="image"]):disabled,
.dark textarea:disabled,
.dark select:disabled,
.dark .synko-select-trigger:disabled,
[data-theme="dark"] input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="file"]):not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="image"]):disabled,
[data-theme="dark"] textarea:disabled,
[data-theme="dark"] select:disabled,
[data-theme="dark"] .synko-select-trigger:disabled {
  background-color: #e2e8f0 !important;
  color: #64748b !important;
  border-color: #cbd5e1 !important;
  -webkit-text-fill-color: #64748b !important;
}

.dark select option,
[data-theme="dark"] select option {
  background-color: #f1f5f9 !important;
  color: #0f172a !important;
}

.dark .synko-select-trigger span,
[data-theme="dark"] .synko-select-trigger span {
  color: #0f172a !important;
}

.dark .synko-select-trigger .synko-select-placeholder,
[data-theme="dark"] .synko-select-trigger .synko-select-placeholder {
  color: #64748b !important;
}

.dark .synko-select-trigger .synko-select-chip,
[data-theme="dark"] .synko-select-trigger .synko-select-chip {
  background-color: #e2e8f0 !important;
  border-color: #cbd5e1 !important;
  color: #0f172a !important;
}

.dark .synko-select-trigger svg,
[data-theme="dark"] .synko-select-trigger svg {
  color: #475569 !important;
}

/* Transparent inputs inside composite search bars */
.dark .synko-search-filter-bar,
.dark .synko-map-search-bar,
[data-theme="dark"] .synko-search-filter-bar,
[data-theme="dark"] .synko-map-search-bar {
  background-color: #f1f5f9 !important;
  border-color: #cbd5e1 !important;
  color: #0f172a !important;
}

.dark .synko-search-filter-bar:focus-within,
.dark .synko-map-search-bar:focus-within,
[data-theme="dark"] .synko-search-filter-bar:focus-within,
[data-theme="dark"] .synko-map-search-bar:focus-within {
  background-color: #f8fafc !important;
  border-color: var(--color-primary) !important;
}

.dark input.bg-transparent,
[data-theme="dark"] input.bg-transparent {
  background-color: transparent !important;
  color: #0f172a !important;
  caret-color: #0f172a !important;
  color-scheme: light !important;
  -webkit-text-fill-color: #0f172a !important;
}

.dark input::placeholder,
.dark textarea::placeholder,
[data-theme="dark"] input::placeholder,
[data-theme="dark"] textarea::placeholder {
  color: #64748b !important;
  opacity: 1 !important;
  -webkit-text-fill-color: #64748b !important;
}

/* Browser Autofill in Dark Mode */
.dark input:-webkit-autofill,
.dark input:-webkit-autofill:hover,
.dark input:-webkit-autofill:focus,
.dark input:-webkit-autofill:active,
.dark textarea:-webkit-autofill,
[data-theme="dark"] input:-webkit-autofill,
[data-theme="dark"] input:-webkit-autofill:hover,
[data-theme="dark"] input:-webkit-autofill:focus,
[data-theme="dark"] input:-webkit-autofill:active,
[data-theme="dark"] textarea:-webkit-autofill {
  -webkit-box-shadow: 0 0 0 1000px #f1f5f9 inset !important;
  -webkit-text-fill-color: #0f172a !important;
  caret-color: #0f172a !important;
  color: #0f172a !important;
}

/* Mouse Text Selection (::selection) in Dark Mode */
.dark ::selection,
.dark input::selection,
.dark textarea::selection,
[data-theme="dark"] ::selection,
[data-theme="dark"] input::selection,
[data-theme="dark"] textarea::selection {
  background-color: #cbd5e1 !important;
  color: #0f172a !important;
  -webkit-text-fill-color: #0f172a !important;
}

.dark ::-moz-selection,
.dark input::-moz-selection,
.dark textarea::-moz-selection,
[data-theme="dark"] ::-moz-selection,
[data-theme="dark"] input::-moz-selection,
[data-theme="dark"] textarea::-moz-selection {
  background-color: #cbd5e1 !important;
  color: #0f172a !important;
}

/* Icons & Adornment Buttons Inside Input Fields in Dark Mode */
.dark .synko-input-icon-btn,
[data-theme="dark"] .synko-input-icon-btn {
  color: #64748b !important;
}

.dark .synko-input-icon-btn:hover,
[data-theme="dark"] .synko-input-icon-btn:hover {
  color: #0f172a !important;
  background-color: rgba(15, 23, 42, 0.08) !important;
}

.dark .relative > svg.pointer-events-none,
[data-theme="dark"] .relative > svg.pointer-events-none {
  color: #64748b !important;
}

/* ==========================================================================
   Google Maps, Places Autocomplete & Leaflet Text Visibility in Both Modes
   ========================================================================== */

/* Google Maps Places Autocomplete Container (.pac-container) */
.pac-container {
  font-family: inherit !important;
  border-radius: 0.75rem !important;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
  border: 1px solid #e2e8f0 !important;
  margin-top: 4px !important;
  z-index: 10000 !important;
}

.pac-item {
  padding: 8px 12px !important;
  font-size: 13px !important;
  color: #0f172a !important;
  border-top: 1px solid #f1f5f9 !important;
  cursor: pointer !important;
}

.pac-item:hover,
.pac-item-selected {
  background-color: #f8fafc !important;
}

.pac-item-query {
  font-size: 13px !important;
  color: #0f172a !important;
  font-weight: 600 !important;
}

.pac-matched {
  color: #0284c7 !important;
  font-weight: 700 !important;
}

/* Google Maps Pac Container in Dark Mode */
.dark .pac-container,
[data-theme="dark"] .pac-container,
.dark.pac-container,
[data-theme="dark"].pac-container {
  background-color: #131b2a !important;
  border-color: #334155 !important;
  color: #f8fafc !important;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5) !important;
}

.dark .pac-item,
[data-theme="dark"] .pac-item,
.dark.pac-container .pac-item,
[data-theme="dark"].pac-container .pac-item {
  color: #cbd5e1 !important;
  border-top-color: #1e293b !important;
}

.dark .pac-item:hover,
.dark .pac-item-selected,
[data-theme="dark"] .pac-item:hover,
[data-theme="dark"] .pac-item-selected,
.dark.pac-container .pac-item:hover,
.dark.pac-container .pac-item-selected,
[data-theme="dark"].pac-container .pac-item:hover,
[data-theme="dark"].pac-container .pac-item-selected {
  background-color: #1e293b !important;
}

.dark .pac-item-query,
[data-theme="dark"] .pac-item-query,
.dark.pac-container .pac-item-query,
[data-theme="dark"].pac-container .pac-item-query {
  color: #f8fafc !important;
}

.dark .pac-matched,
[data-theme="dark"] .pac-matched,
.dark.pac-container .pac-matched,
[data-theme="dark"].pac-container .pac-matched {
  color: #38bdf8 !important;
}

/* Fallback: If Google Autocomplete retains white background in dark mode */
.pac-container:not(.dark):not([data-theme="dark"]) .pac-item,
.pac-container[style*="background-color: rgb(255, 255, 255)"] .pac-item,
.pac-container[style*="background-color: #fff"] .pac-item {
  color: #0f172a !important;
}
.pac-container:not(.dark):not([data-theme="dark"]) .pac-item-query,
.pac-container[style*="background-color: rgb(255, 255, 255)"] .pac-item-query,
.pac-container[style*="background-color: #fff"] .pac-item-query {
  color: #0f172a !important;
}

/* Google Maps / Leaflet Inputs & Controls */
.leaflet-container input,
.gm-style input {
  font-family: inherit;
}

/* White background search input inside maps in dark mode */
.dark .leaflet-container [class*="bg-white"] input:not([class*="dark:text-"]),
[data-theme="dark"] .leaflet-container [class*="bg-white"] input:not([class*="dark:text-"]) {
  color: #0f172a !important;
  caret-color: #0f172a !important;
  color-scheme: light !important;
  -webkit-text-fill-color: #0f172a !important;
}

/* Google Maps Info Windows (.gm-style-iw) */
.dark .gm-style .gm-style-iw-c,
[data-theme="dark"] .gm-style .gm-style-iw-c {
  background-color: #131b2a !important;
  color: #f8fafc !important;
  border: 1px solid #1e293b !important;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5) !important;
}

.dark .gm-style .gm-style-iw-d,
[data-theme="dark"] .gm-style .gm-style-iw-d {
  color: #cbd5e1 !important;
}

.dark .gm-style .gm-style-iw-tc::after,
[data-theme="dark"] .gm-style .gm-style-iw-tc::after {
  background-color: #131b2a !important;
}

/* Leaflet in Dark Mode */
.dark .leaflet-container,
[data-theme="dark"] .leaflet-container {
  background-color: #0b0f17;
}

.dark .leaflet-popup-content-wrapper,
.dark .leaflet-popup-tip,
[data-theme="dark"] .leaflet-popup-content-wrapper,
[data-theme="dark"] .leaflet-popup-tip {
  background: #131b2a;
  color: #f8fafc;
  border: 1px solid #1e293b;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
}

.dark .leaflet-bar a,
[data-theme="dark"] .leaflet-bar a {
  background-color: #131b2a;
  color: #f8fafc;
  border-bottom: 1px solid #1e293b;
}

.dark .leaflet-bar a:hover,
[data-theme="dark"] .leaflet-bar a:hover {
  background-color: #1e293b;
}

.dark .leaflet-control-attribution,
[data-theme="dark"] .leaflet-control-attribution {
  background: rgba(11, 15, 23, 0.85) !important;
  color: #94a3b8 !important;
}

.dark .leaflet-control-attribution a,
[data-theme="dark"] .leaflet-control-attribution a {
  color: #38bdf8 !important;
}
