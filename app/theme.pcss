@custom-variant dark (&:where(.dark, .dark *, [data-theme="dark"], [data-theme="dark"] *));

@theme {
  --color-base-100: oklch(98% 0.02 240);
  --color-base-200: oklch(95% 0.03 240);
  --color-base-300: oklch(92% 0.04 240);
  --color-base-content: oklch(20% 0.05 240);

  --color-primary: oklch(55% 0.3 240);
  --color-primary-content: oklch(98% 0.01 240);
  --color-secondary: oklch(70% 0.25 200);
  --color-secondary-content: oklch(98% 0.01 200);
  --color-accent: oklch(65% 0.25 160);
  --color-accent-content: oklch(98% 0.01 160);
  --color-neutral: oklch(50% 0.05 240);
  --color-neutral-content: oklch(98% 0.01 240);
  --color-info: oklch(70% 0.2 220);
  --color-info-content: oklch(98% 0.01 220);
  --color-success: oklch(65% 0.25 140);
  --color-success-content: oklch(98% 0.01 140);
  --color-warning: oklch(80% 0.25 80);
  --color-warning-content: oklch(20% 0.05 80);
  --color-error: oklch(65% 0.3 30);
  --color-error-content: oklch(98% 0.01 30);

  --radius-selector: 1rem;
  --radius-field: 0.25rem;
  --radius-box: 0.5rem;
}

@utility btn-primary {
  background-color: var(--color-primary);
  color: var(--color-primary-content);
  box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.08), inset 0 1px 0 0 rgba(255, 255, 255, 0.16);

  &:hover {
    filter: brightness(0.96);
    transform: translateY(-0.5px);
  }

  &:active {
    transform: translateY(0);
  }
}

@utility btn-secondary {
  background-color: #ffffff;
  border-width: 1px;
  border-style: solid;
  border-color: #e2e8f0;
  color: #0f172a;
  box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.04);

  &:hover {
    background-color: #f8fafc;
    border-color: #cbd5e1;
  }
}

@utility btn-ghost {
  background-color: transparent;
  border-width: 1px;
  border-style: solid;
  border-color: transparent;
  color: var(--color-base-content);

  &:hover {
    background-color: rgba(148, 163, 184, 0.12);
  }
}

:root {
  color-scheme: light;
  font-family: Manrope, "Noto Sans Armenian", ui-sans-serif, system-ui, sans-serif;
}

.dark, [data-theme="dark"] {
  color-scheme: dark;
  --color-base-100: oklch(22% 0.02 240);
  --color-base-200: oklch(17% 0.02 240);
  --color-base-300: oklch(28% 0.03 240);
  --color-base-content: oklch(96% 0.01 240);
}

[data-account-type="horeca"] {
  --color-primary: #ea580c;
  --color-primary-content: #ffffff;
}

[data-account-type="supplier"] {
  --color-primary: #0284c7;
  --color-primary-content: #ffffff;
}

.dark [data-account-type="horeca"],
[data-theme="dark"] [data-account-type="horeca"] {
  --color-primary: #f97316;
  --color-primary-content: #ffffff;
}

.dark [data-account-type="supplier"],
[data-theme="dark"] [data-account-type="supplier"] {
  --color-primary: #0ea5e9;
  --color-primary-content: #ffffff;
}

body {
  background-color: #f8fafc;
  color: #0f172a;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.dark body,
[data-theme="dark"] body {
  background-color: #0b0f17;
  color: #f1f5f9;
}

/* Clean neutral surface overrides for legacy warm/sage backgrounds in light mode */
:root:not(.dark):not([data-theme="dark"]) .bg-\[\#f3f6f4\] {
  background-color: #f8fafc;
}

:root:not(.dark):not([data-theme="dark"]) .bg-\[\#f3f6f4\]\/95 {
  background-color: rgba(248, 250, 252, 0.95);
}

:root:not(.dark):not([data-theme="dark"]) .bg-\[\#fffefa\],
:root:not(.dark):not([data-theme="dark"]) .bg-\[\#fcfaf5\] {
  background-color: #ffffff;
}

:root:not(.dark):not([data-theme="dark"]) .bg-\[\#f5f8f2\],
:root:not(.dark):not([data-theme="dark"]) .bg-\[\#fbfcfa\] {
  background-color: #f8fafc;
}

/* ==========================================================================
   Dark Theme Surface & Text Palette (Curated & Harmonious)
   ========================================================================== */

.dark .bg-\[\#f3f6f4\],
[data-theme="dark"] .bg-\[\#f3f6f4\] {
